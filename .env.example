# Solana Memecoin Trading Bot
# =========================
# Environment Configuration
# Copy to .env and fill in values

# ──── MODE ─────────────────────────────────────────
PAPER_TRADING=true
LIVE_TRADING=false
LIVE_CONFIRMATION=false

# ──── STRATEGY ─────────────────────────────────────
POSITION_SIZE_SOL=0.10
STARTING_PAPER_CAPITAL_SOL=0.10
NET_TARGET_PERCENT=10
MIN_SCORE=80

# ──── TOKEN FILTERS ────────────────────────────────
MIN_TOKEN_AGE_SECONDS=20
MAX_TOKEN_AGE_SECONDS=180
OBSERVATION_SECONDS=30

# ──── LIQUIDITY ────────────────────────────────────
MIN_LIQUIDITY_USD=20000
MIN_LIQUIDITY_TO_MCAP_RATIO=0.05

# ──── HOLDERS ──────────────────────────────────────
MAX_TOP10_HOLDER_PERCENT=25
MAX_SINGLE_HOLDER_PERCENT=5

# ──── EXECUTION ────────────────────────────────────
MAX_SLIPPAGE_BPS=300

# ──── RISK MANAGEMENT ─────────────────────────────
MAX_DAILY_LOSS_PERCENT=10
MAX_CONSECUTIVE_LOSSES=5
MAX_TRADES_PER_HOUR=20
EMERGENCY_EXIT_COOLDOWN_SECONDS=300

# ──── SOLANA RPC ───────────────────────────────────
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com

# ──── JUPITER ──────────────────────────────────────
JUPITER_API_URL=https://api.jup.ag/swap/v2
JUPITER_API_KEY=

# ──── DATABASE ─────────────────────────────────────
# For local dev, leave empty to use SQLite
DATABASE_URL=
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/memecoin_bot

# ──── TELEGRAM ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──── WALLET ───────────────────────────────────────
# Path to encrypted keypair file (NOT the key itself)
WALLET_KEYPAIR_PATH=
# Passphrase for decrypting the keypair (set at runtime, not stored)
# WALLET_PASSPHRASE=

# ──── SERVER ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ──── LOGGING ──────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/bot.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ──── ADAPTIVE STRATEGY ENGINE ────────────────────
# Strategy sample thresholds
STRATEGY_MIN_TRADES=50
STRATEGY_CONFIDENT_TRADES=200

# Exploration vs exploitation
EXPLORATION_RATE=0.10
MIN_EXPLORATION_RATE=0.02
EXPLORATION_DECAY_TRADES=500
MIN_STRATEGY_SWITCH_IMPROVEMENT=10

# Minimum fitness to execute a trade
MIN_SELECTOR_FITNESS=75

# Capital protection
CAPITAL_RESERVE_PERCENT=50

# Strategy degradation
DEGRADATION_WINDOW=20
DEGRADATION_EXPECTANCY_THRESHOLD=-2.0
MAX_STRATEGY_CONSECUTIVE_LOSSES=5

# Fast Scalper (Strategy A)
FAST_SCALPER_TARGET_PERCENT=10
FAST_SCALPER_MAX_HOLD_SECONDS=300

# Momentum Runner (Strategy B)
MOMENTUM_TRAILING_STOP_PERCENT=15
MOMENTUM_MAX_HOLD_SECONDS=900
MOMENTUM_MIN_BUYER_ACCELERATION=1.5
MOMENTUM_MIN_BUY_SELL_RATIO=0.55

# Smart Wallet Follower (Strategy C)
SMART_WALLET_MIN_TRADES=30
SMART_WALLET_MIN_SCORE=60
SMART_WALLET_TARGET_PERCENT=15

